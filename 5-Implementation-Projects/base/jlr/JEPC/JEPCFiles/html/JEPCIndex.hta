<HTML>
	<HEAD>
		<HTA:APPLICATION
		  ID="JEPCAPP"
		  BORDER="THICK"
		  INNERBORDER="YES"
		  BORDERSTYLE="NONE"
		  SCROLL="NO"
		  CAPTION="YES"
		  SHOWINTASKBAR="YES"
		  CONTEXTMENU="NO"  
		  SINGLEINSTANCE="YES"
		  SYSMENU="YES"
		  WINDOWSTATE="MAXIMIZE"
		  NAVIGABLE="YES"
		  ICON="../images/jag.ico"
		/>
		<TITLE>JEPC Mark III</TITLE>
		<META HTTP-EQUIV="CACHE-CONTROL" CONTENT="NO-CACHE" />
	</HEAD>
	<BODY>
		<IFRAME
		  SRC=JEPCLogin.html
		  TRUSTED="YES"
		  WIDTH= 100% 
		  HEIGHT= 100%
		  MARGINWIDTH=0
		  MARGINHEIGHT=0
		  BORDER=0
		  APPLICATION="YES">
		</IFRAME>
	</BODY>
</HTML>
  
